{
  "name": "explain-ahmad",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "frames": "node scripts/capture-beats.mjs",
    "frames:opening": "node scripts/capture-beats.mjs --beats=1-14",
    "frames:s1": "node scripts/capture-frames.mjs",
    "record:s1": "node scripts/record-section.mjs",
    "frames:gpt": "node scripts/review-gpt-section.mjs",
    "record:gpt": "node scripts/review-gpt-section.mjs --record",
    "check:chain": "node scripts/check-chain.mjs",
    "check": "tsc -b && node scripts/check-chain.mjs",
    "frames:s7": "node scripts/capture-frames.mjs --section=section-07",
    "frames:s2": "node scripts/capture-frames.mjs --section=section-02",
    "frames:s3": "node scripts/capture-frames.mjs --section=section-03",
    "frames:s4": "node scripts/capture-frames.mjs --section=section-04",
    "frames:s5": "node scripts/capture-frames.mjs --section=section-05",
    "frames:s6": "node scripts/capture-frames.mjs --section=section-06",
    "frames:s8": "node scripts/capture-frames.mjs --section=section-08",
    "frames:all": "for s in 01 02 03 04 05 06 07 08; do node scripts/capture-frames.mjs --section=section-$s; done",
    "board": "node scripts/board.mjs"
  },
  "dependencies": {
    "@fontsource/caveat": "^5.3.0",
    "@fontsource/patrick-hand": "^5.3.0",
    "@xstate/react": "^6.1.0",
    "@xyflow/react": "^12.11.6",
    "cmdk": "^1.1.1",
    "gsap": "^3.15.0",
    "lenis": "^1.3.0",
    "lucide-react": "^1.41.0",
    "motion": "^13.0.0",
    "perfect-freehand": "^1.2.3",
    "react": "latest",
    "react-dom": "latest",
    "react-kino": "^0.5.0",
    "react-router": "^8.3.1",
    "rough-notation": "^0.5.1",
    "roughjs": "^4.6.6",
    "xstate": "^5.32.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "esbuild": "^0.28.2",
    "playwright": "^1.63.0",
    "typescript": "latest",
    "vite": "latest"
  }
}
